# Copy to .env and adjust for your environment.

# Path to the SQLite database file
NANOBROKER_DB_FILE=broker_local.db

# Bind address (0.0.0.0 exposes to the whole LAN)
NANOBROKER_HOST=0.0.0.0

# HTTP port
NANOBROKER_PORT=8000

# Log level: DEBUG, INFO, WARNING, ERROR
NANOBROKER_LOG_LEVEL=INFO

# SQLite busy timeout in seconds
NANOBROKER_DB_TIMEOUT=5

# --- V2 prod (online) ---
# API key para push/pop/peek (vacío = modo LAN abierto)
NANOBROKER_API_KEY=
# Admin key para /system/* y purge (vacío = abierto, NO usar en internet)
NANOBROKER_ADMIN_KEY=
# CORS, coma-separado (* solo LAN)
NANOBROKER_CORS_ORIGINS=*
# Rate limit por IP+key por minuto (0 = off)
NANOBROKER_RATE_LIMIT_PER_MIN=120
# Tamaño máximo payload en KB
NANOBROKER_MAX_BODY_KB=256
# Tope peek/dlq
NANOBROKER_MAX_PEEK=100
